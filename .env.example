MAX_BATCH_IMAGES=500
MAX_WORKERS=2
MAX_WORKER_LIMIT=8
RUNTIME_DIR=runtime
GENERATE_ANNOTATIONS=false
JOB_RETENTION_HOURS=24
JOB_STUCK_SECONDS=300
OCR_TIMEOUT_SECONDS=30
