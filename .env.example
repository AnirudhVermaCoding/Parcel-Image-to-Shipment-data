XAI_TIMEOUT_SECONDS=45
XAI_MAX_RETRIES=2
XAI_MAX_IMAGES_PER_JOB=50
XAI_MAX_CONCURRENCY=2
VISION_CACHE_ENABLED=true
VISION_PROMPT_VERSION=parcel-observation-v2
